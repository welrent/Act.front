# Lakebase Postgres (pooled). Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/welrent?sslmode=require

# Public origin used in contract URLs.
ACT_PUBLIC_URL=http://127.0.0.1:8787

# Optional. When set, POST /api/contracts requires header X-Welrent-Key.
WELRENT_INGEST_KEY=

# Seeded accounts. Change before any shared deployment.
ADMIN_EMAIL=admin@id.welrent.com
ADMIN_PASSWORD=change-me
DEMO_EMAIL=demo@welrent.com
DEMO_PASSWORD=change-me

# Neon Object Storage (S3-compatible).
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=actfiles

# Neon AI Gateway. Injected by `neon deploy` when aiGateway is enabled.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

PORT=8787
